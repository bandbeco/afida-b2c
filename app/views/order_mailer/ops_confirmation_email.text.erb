-------------
<% @order.order_items.each do |item| %>
<%= item.quantity %>x <%= item.product_name %><%= item.sample? ? " (Sample)" : "" %> - <%= item.sample? ? "FREE" : number_to_currency(item.line_total, unit: "£") %>
