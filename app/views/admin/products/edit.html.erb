<% content_for :title, "#{@product.generated_title}" %>

<div class="container mx-auto px-4 py-8 max-w-4xl">
  <h1>Editing Product: <%= @product.generated_title %></h1>

  <%= render "form", product: @product %>

  <%# Compatible Lids Section - Separate from product form to avoid nested form issues %>
  <%# Any non-lid product can take compatible lids (cups, soup containers, bowls...) %>
  <% if @product.persisted? && !@product.lid_product? %>
    <%= render 'compatible_lids', product: @product %>
  <% end %>
</div>
