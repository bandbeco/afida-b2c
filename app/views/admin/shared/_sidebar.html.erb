        </svg>
        Branded Orders
        <% pending_count = Order.branded_orders.where(branded_order_status: ["design_pending", "design_approved"]).count %>
        <% if pending_count > 0 %>
          <span class="badge badge-warning badge-sm"><%= pending_count %></span>
        <% end %>
      <% end %>
    </li>
    <li>
      <%= link_to admin_leaderboard_entries_path, class: "#{request.path.start_with?('/admin/leaderboard_entries') ? 'active' : ''}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
