<%# Search results for modal - larger display than header dropdown %>
<%# Variables: @rows (collapsed result rows), @query (search term), @total_count (total row count) %>

<% if @query.blank? || @query.length < 2 %>
  <div class="text-center py-12 text-gray-500">
    <p>Type at least 2 characters to search</p>
  </div>
<% elsif @rows.empty? %>
  <div class="text-center py-12">
    <svg class="mx-auto w-16 h-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <p class="text-gray-500 text-lg">No results found for "<%= @query %>"</p>
    <p class="text-gray-400 mt-2">Try a different search term or browse our categories</p>
  </div>
<% else %>
  <%# Results header. The count line links straight to the full results page so
  %>
  <%# it is reachable without scrolling past every row (issue #249). It is also
  %>
  <%# an aria-live region so screen readers announce the result count (#250). %>
  <div class="mb-4 flex items-center justify-between" aria-live="polite">
    <%= link_to shop_path(q: @query),
                class: "text-sm text-gray-500 hover:text-primary transition",
                data: { turbo_frame: "_top" } do %>
      <% if @total_count > @rows.size %>
        Showing <%= @rows.size %> of <%= @total_count %> results for "<%= @query %>"
      <% else %>
        <%= pluralize(@rows.size, "result") %> for "<%= @query %>"
      <% end %>
    <% end %>
  </div>

  <%# Results list - horizontal stacked rows for better differentiation. The
  %>
  <%# listbox/option roles and per-row ids back the ARIA combobox and the
  %>
  <%# keyboard navigation in the Stimulus controller (issue #250). %>
  <div class="space-y-2" role="listbox" aria-label="Search results" data-search-modal-target="listbox">
    <% @rows.each_with_index do |row, index| %>
      <%= render partial: "search/result_row", locals: { row: row, compact: false, option_index: index } %>
    <% end %>
  </div>

  <%# View all link %>
  <% if @total_count > @rows.size %>
    <div class="mt-6 text-center">
      <%= link_to shop_path(q: @query),
                  class: "inline-flex items-center gap-2 px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-focus transition font-medium",
                  data: { turbo_frame: "_top" } do %>
        View all <%= @total_count %> results
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      <% end %>
    </div>
  <% end %>
<% end %>
