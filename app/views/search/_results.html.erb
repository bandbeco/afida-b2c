<%# Search results partial - rendered in header dropdown and full search page %>
<%# Variables: @rows (collapsed result rows), @query (search term) %>

<% if @query.blank? || @query.length < 2 %>
  <div class="p-4 text-center text-gray-500">
    Type at least 2 characters to search
  </div>
<% elsif @rows.empty? %>
  <div class="p-4 text-center text-gray-500">
    No results found for "<%= @query %>"
  </div>
<% else %>
  <div class="divide-y divide-gray-100">
    <% @rows.each do |row| %>
      <%= render partial: "search/result_row", locals: { row: row, compact: true } %>
    <% end %>
  </div>

  <%# View all link %>
  <%= link_to shop_path(q: @query),
              class: "block p-3 text-center text-sm text-primary hover:bg-base-200 border-t",
              data: { turbo_frame: "_top" } do %>
    View all results for "<%= @query %>"
  <% end %>
<% end %>
