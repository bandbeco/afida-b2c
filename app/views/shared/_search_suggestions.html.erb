<%# Reusable search suggestions block (issue #251). %>
<%# Rendered both in the modal's default (pre-typing) content and in the %>
<%# no-results state, so a zero-result query is never a dead end. %>
<%# %>
<%# Recent searches are hydrated client-side from localStorage by the search %>
<%# modal Stimulus controller; the list starts empty and hidden and is %>
<%# revealed only when there is history to show. %>

<%
  quick_terms = ["Cups", "Pizza boxes", "Napkins", "Straws", "Takeaway containers", "Ice cream"]
%>

<%# Recent searches (populated from localStorage) %>
<div class="mb-8 hidden" data-search-modal-target="recentSearches">
  <div class="flex items-center justify-between mb-3">
    <p class="text-sm font-medium text-gray-500">Recent searches</p>
    <button type="button"
            data-action="click->search-modal#clearRecentSearches"
            class="text-xs text-gray-400 hover:text-gray-600 transition">
      Clear
    </button>
  </div>
  <div class="flex flex-wrap gap-2" data-search-modal-target="recentSearchesList"></div>
</div>

<%# Most searched chips %>
<div class="mb-8">
  <p class="text-sm font-medium text-gray-500 mb-3">Most searched</p>
  <div class="flex flex-wrap gap-2">
    <% quick_terms.each do |term| %>
      <button type="button"
              data-action="click->search-modal#quickSearch"
              data-term="<%= term %>"
              class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-full text-sm transition border border-black">
        <%= term %>
      </button>
    <% end %>
  </div>
</div>
