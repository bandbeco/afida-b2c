<div id="drawer_cart_content" class="flex flex-col h-full">
  <% notice ||= nil %>
  <% if notice %>
    <%= render "shared/flash_info", message: notice %>
  <% end %>

  <div class="flex items-center justify-between mb-5 flex-shrink-0">
    <h2 class="flex items-center gap-2 text-xl sm:text-2xl">
      Cart
      <% if Current.cart && Current.cart.line_items_count > 0 %>
        <span class="bg-primary text-primary-content text-sm px-2.5 py-0.5 rounded-full"><%= Current.cart.line_items_count %></span>
      <% end %>
    </h2>
  </div>

  <% if Current.cart && Current.cart.line_items_count.positive? %>
    <div class="space-y-3 mb-4 flex-1 overflow-y-auto min-h-0 scrollbar-visible">
      <% Current.cart.cart_items.includes(product: [:category, :product_photo_attachment, :lifestyle_photo_attachment]).each do |cart_item| %>
        <% if cart_item.product.present? %>
          <div class="flex items-center space-x-3 p-3 bg-base-100 rounded-lg">
            <div class="relative flex-shrink-0">
              <%= product_photo_tag(cart_item.product.primary_photo, alt: cart_item.product.generated_title, class: "w-16 h-16 rounded bg-white object-contain") %>
              <% if cart_item.sample? %>
                <%= render "shared/sample_badge", size: :sm %>
              <% end %>
            </div>

            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium truncate"><%= cart_item.product.generated_title %></p>
              <p class="text-xs text-gray-500 truncate">
                <% if cart_item.configured? %>
                  Size: <%= cart_item.configuration["size"] %>
                <% else %>
                  <%= cart_item.product.category&.name %>
                <% end %>
              </p>
              <div class="flex justify-between items-center mt-1">
                <span class="text-xs">
                  <% if cart_item.sample? %>
                    1 unit
                  <% else %>
                    <%= format_quantity_display(cart_item) %>
                  <% end %>
                </span>
                <span class="text-sm font-medium">
                  <% if cart_item.sample? %>
                    Free
                  <% else %>
                    <%= number_to_currency(cart_item.subtotal_amount) %>
                  <% end %>
                </span>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="border-t pt-4 flex-shrink-0">
      <%# Lines come from CartSummary (the same source the cart page uses, mirroring
          OrderSummary for orders) so the labels, order and discount-visibility stay
          consistent across both cart surfaces; the drawer supplies its own compact
          row markup.

          The Total is set apart by size and a rule above it rather than by weight
          (the project uses no bold or semibold anywhere), so it still reads as the
          figure that matters on a panel this wide. %>
      <% cart_summary_lines(Current.cart).each do |line| %>
        <% total = line[:kind] == :total %>
        <%# The total's generous gap below it was holding the checkout button
            clear of the figures. The countdown band now occupies that space, so
            the gap closes to the band's own margin. %>
        <div class="flex justify-between items-center <%= total ? "mt-4 pt-4 border-t border-base-300 mb-5" : "mb-3" %><%= " text-success" if line[:negative] %>">
          <span class="<%= total ? "text-lg" : "text-sm sm:text-base text-gray-600" %>"><%= line[:label] %></span>
          <span class="<%= total ? "text-xl sm:text-2xl" : "text-sm sm:text-base" %>"><%= line[:amount] %></span>
        </div>
      <% end %>

      <%# The countdown, directly above the checkout control. The drawer opens on
          every add-to-cart, so this is the surface the nudge is seen on most and
          the one where the buyer is best placed to act on it: they are already
          shopping, and the panel closes back onto the page they were browsing.

          It also answers the Shipping line right above it. That line reads
          "Calculated at checkout" (the cart collects no destination), which
          leaves delivery looking like a cost still waiting at payment; the
          qualified state says plainly that it is not.

          Its own id, because this partial is replaced wholesale by the same
          streams that replace the buy box's #free_delivery_hint, and on the PDP
          both are in the document at once. %>
      <%= render "shared/free_delivery_hint", id: "drawer_free_delivery_hint", spacing: "mb-4" %>

      <div>
        <%= render "shared/checkout_button", label: "Proceed to Checkout", button_class: "btn btn-primary btn-lg w-full text-base shadow-lg shadow-black/20" %>
      </div>
    </div>
  <% else %>
    <div class="text-center py-8">
      <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      <p class="text-gray-500 text-sm mb-4">Your cart is empty</p>
      <%= link_to "Continue Shopping", "#", class: "btn btn-outline btn-sm w-full", data: { action: "click->cart-drawer#close" } %>
    </div>
  <% end %> 
</div>