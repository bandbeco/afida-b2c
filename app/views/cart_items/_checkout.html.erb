<%# The cart page's checkout form: the address selector and the Proceed button,
    whose disabled state depends on whether we know where the order is going.

    Wrapped in #cart_checkout and replaced by the delivery-postcode Turbo Stream,
    because `disabled` is decided HERE at render time. This block sits outside
    both #cart_summary and #delivery_calculator, so when the stream replaced only
    those the button kept showing the previous answer: enter a valid postcode and
    it stayed disabled while the totals repriced in front of the customer; clear
    one and it stayed enabled, sending them into a checkout the guard refuses.

    Pass the cart as `cart`. %>
<div id="cart_checkout">
  <%# Checkout form with optional address selection. The analytics wiring comes from
      the shared analytics_checkout_form_data so the begin_checkout contract has one home. %>
  <%= form_with url: checkout_path, method: :post, data: analytics_checkout_form_data(cart) do |f| %>

    <% if Current.user&.has_saved_addresses? %>
      <%# Inline address selector for logged-in users %>
      <div class="mt-4 pt-4 border-t border-gray-200">
        <p class="text-sm font-medium text-gray-700 mb-3">Deliver to:</p>
        <div class="space-y-2">
          <% Current.user.addresses.default_first.each do |address| %>
            <label class="flex items-start gap-2 p-2 rounded-lg cursor-pointer hover:bg-gray-200 transition-colors has-[:checked]:bg-primary/10 has-[:checked]:ring-1 has-[:checked]:ring-primary">
              <input type="radio"
                     name="address_id"
                     value="<%= address.id %>"
                     class="radio radio-primary radio-sm mt-0.5"
                     <%= "checked" if address.default? %>>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <span class="font-medium text-sm truncate"><%= address.nickname %></span>
                  <% if address.default? %>
                    <span class="badge badge-primary badge-xs">Default</span>
                  <% end %>
                </div>
                <p class="text-xs text-gray-500 truncate">
                  <%= address.line1 %>, <%= address.city %> <%= address.postcode %>
                </p>
              </div>
            </label>
          <% end %>

          <%# Option to enter a different address %>
          <label class="flex items-start gap-2 p-2 rounded-lg cursor-pointer hover:bg-gray-200 transition-colors has-[:checked]:bg-primary/10 has-[:checked]:ring-1 has-[:checked]:ring-primary">
            <input type="radio"
                   name="address_id"
                   value=""
                   class="radio radio-primary radio-sm mt-0.5">
            <div class="flex-1">
              <span class="font-medium text-sm">Enter a different address</span>
              <p class="text-xs text-gray-500">Enter its postcode above so we can price delivery</p>
            </div>
          </label>
        </div>
      </div>
    <% end %>

    <%# Delivery is priced into the Stripe line items before Stripe collects
        the address, so checkout is refused without a destination. Disable
        the button rather than letting the customer bounce off the guard.

        This asks the same question CheckoutsController#deliverable_destination?
        asks, in the same order (typed postcode, then selected address,
        then the default address). They MUST agree: when they didn't, a
        customer who picked "enter a different address" saw an enabled
        button, was refused by the guard, and landed back on a cart whose
        button was still enabled, with nothing pointing at the fix. %>
    <% destination_known = delivery_destination_known?(cart, address_postcode: cart_owner_default_postcode(cart)) %>
    <div class="mt-4 sm:mt-6">
      <button type="submit"
              class="btn btn-primary btn-block text-base sm:text-lg shadow-lg shadow-black/20"
              <%= "disabled" unless destination_known %>>
        Proceed to Checkout
      </button>
      <% unless destination_known %>
        <p class="mt-2 text-xs text-center text-gray-600" data-test="checkout-blocked-note">
          Enter your delivery postcode above to continue.
        </p>
      <% end %>
    </div>
  <% end %>
</div>
