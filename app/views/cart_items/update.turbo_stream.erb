<%= turbo_stream.replace "cart_counter", partial: "shared/cart_counter" %>

<%# Keep the slide-out drawer in step with the cart (no-op where it isn't mounted), so
    its line items, totals and begin_checkout data attributes never go stale. %>
<%= turbo_stream.replace "drawer_cart_content" do %>
  <%= render "shared/drawer_cart_content" %>
<% end %>

<%# Update unit price display (for branded products where price changes with quantity) %>
<%= turbo_stream.update "cart_item_#{@cart_item.id}_price" do %>
  <%= format_price_display(@cart_item) %>
<% end %>

<%= turbo_stream.update "cart_item_#{@cart_item.id}_price_mobile" do %>
  <%= format_price_display(@cart_item) %>
<% end %>

<%# Update line totals %>
<%= turbo_stream.update "cart_item_#{@cart_item.id}_total" do %>
  <%= number_to_currency(@cart_item.line_total) %>
<% end %>

<%= turbo_stream.update "cart_item_#{@cart_item.id}_total_mobile" do %>
  <%= number_to_currency(@cart_item.line_total) %>
<% end %>

<%# Replace the whole summary in one shot (subtotal, shipping, discount line, VAT
    and total all move together when a quantity changes or shipping flips), so the
    lines can never refresh out of step. Sourced from CartSummary, the same lines
    the cart page rendered initially. %>
<%= turbo_stream.replace "cart_summary", partial: "cart_items/summary", locals: { cart: Current.cart } %>

<%# Replace the whole signup success box (it lives outside #cart_summary), not just
    the savings figure. Its WORDING depends on the cart clearing the coupon's £100
    minimum, so a quantity change that crosses the threshold in either direction has
    to re-render the box: patching only the number left "Add £X more to use it" on a
    cart that now qualifies, contradicting the discount line beside it. %>
<% if session[:discount_code].present? && Current.cart.cart_items.any? %>
  <%= turbo_stream.replace "discount-signup",
        partial: "email_subscriptions/success",
        locals: { cart: Current.cart } %>
<% end %>

<%# The free-delivery countdown reads the cart, so it refreshes with it. A no-op
    on pages that do not mount the hint.
    The buy box's copy and the cart page's are separate targets: unlike destroy,
    this stream does not re-render the #cart frame, so the cart page's band is
    only refreshed by naming it. The drawer's copy rides along inside
    #drawer_cart_content above. %>
<%= turbo_stream.replace "free_delivery_hint", partial: "shared/free_delivery_hint" %>
<%= turbo_stream.replace "cart_free_delivery_hint",
      partial: "shared/free_delivery_hint",
      locals: { id: "cart_free_delivery_hint", spacing: "mt-4" } %>
