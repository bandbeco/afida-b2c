<h1 class="text-3xl mb-3">Opening review queue</h1>
<p class="mb-6">These businesses were first seen in the FSA awaiting-inspection results. Verify their opening date and location before outreach.</p>
<%= form_with url: lead_monitor_leads_path, method: :get, class: "flex gap-3 items-end mb-6" do |form| %>
  <div>
    <%= form.label :classification, "Opening classification", class: "block mb-1" %>
    <%= form.select :classification, LeadMonitor::Lead::CLASSIFICATIONS.map { |key, label| [label, key] }, { include_blank: "All candidates", selected: @classification }, class: "select select-bordered" %>
  </div>
  <%= form.submit "Filter", class: "btn btn-primary" %>
  <%= link_to "Export CSV", lead_monitor_leads_path(format: :csv, classification: @classification), class: "btn" %>
<% end %>
<div class="overflow-x-auto bg-base-100 rounded-box">
  <table class="table">
    <thead><tr><th>Business</th><th>Location</th><th>Opening classification</th><th>Contact status</th><th>Next follow-up</th></tr></thead>
    <tbody>
      <% @leads.each do |lead| %>
        <tr>
          <td><%= link_to lead.business_name, lead_monitor_lead_path(lead), class: "link" %></td>
          <td><%= lead.postcode %><br><%= lead.local_authority %></td>
          <td><%= LeadMonitor::Lead::CLASSIFICATIONS.fetch(lead.classification) %><% if %w[upcoming recent].include?(lead.classification) && !lead.opening_eligible? %><br><span class="text-error">Recheck opening date</span><% end %></td>
          <td><%= lead.outreach_status.humanize %></td>
          <td><%= lead.next_follow_up_on || "—" %></td>
        </tr>
      <% end %>
      <% if @leads.empty? %><tr><td colspan="5">No candidates in this view.</td></tr><% end %>
    </tbody>
  </table>
</div>
<div class="flex gap-4 my-4">
  <% if @page > 1 %><%= link_to "Previous", lead_monitor_leads_path(page: @page - 1, classification: @classification), class: "link" %><% end %>
  <% if @leads.size == 50 %><%= link_to "Next", lead_monitor_leads_path(page: @page + 1, classification: @classification), class: "link" %><% end %>
</div>
<h2 class="text-xl mt-8 mb-3">Recent discovery runs</h2>
<ul class="space-y-2">
  <% @runs.each do |run| %>
    <li><%= run.created_at.to_fs(:short) %> — <%= run.source %>: <%= run.status %>, <%= run.fetched_count %> fetched, <%= run.new_count %> candidates. Digest <%= run.notified_at ? "delivered" : "pending" %><% if run.error %> — <%= run.error %><% end %></li>
  <% end %>
</ul>
