<%#
  Product Show Page
  Phase 1: One page per product (formerly variant)

  Uses: quantity-selector controller for simple quantity selection
  Data: @product, @related_products
%>

<% content_for :title do %>
<%= @product.meta_title.presence || @product.generated_meta_title %>
<% end %>

<% content_for :meta_description do %>
<%= @product.meta_description.presence || @product.generated_meta_description %>
<% end %>

<%# Lift the floating WhatsApp button above the mobile sticky add-to-cart bar %>
<% content_for :whatsapp_lift, true %>

<%# Prefill the WhatsApp message with this product's name and SKU so the lead arrives with context %>
<% content_for :whatsapp_message_suffix, ", re: #{@product.generated_title} (#{@product.sku})" %>

<% if @product&.primary_photo&.attached? %>
  <% content_for :og_image, rails_storage_proxy_url(@product.primary_photo.variant(resize_to_limit: [1200, 630])) %>
<% end %>

<% content_for :og_tags_custom, true %>
<% content_for :twitter_tags_custom, true %>
<% content_for :head do %>
  <!-- Twitter Card meta tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= @product.generated_title %>">
  <meta name="twitter:description" content="<%= @product.description_standard_with_fallback %>">
  <% if @product&.primary_photo&.attached? %>
    <meta name="twitter:image" content="<%= rails_storage_proxy_url(@product.primary_photo.variant(resize_to_limit: [1200, 630])) %>">
  <% end %>

  <!-- Open Graph meta tags -->
  <meta property="og:type" content="product">
  <meta property="og:title" content="<%= @product.generated_title %>">
  <meta property="og:description" content="<%= @product.description_standard_with_fallback %>">
  <meta property="og:url" content="<%= polymorphic_url(@product) %>">
  <meta property="og:site_name" content="Afida">
  <% if @product&.primary_photo&.attached? %>
    <meta property="og:image" content="<%= rails_storage_proxy_url(@product.primary_photo.variant(resize_to_limit: [1200, 630])) %>">
  <% end %>
  <meta property="product:price:amount" content="<%= @product.pricing_tiers.present? ? @product.pricing_tiers.first["price"] : @product.price %>">
  <meta property="product:price:currency" content="GBP">

  <script type="application/ld+json">
    <%= raw product_structured_data(@product) %>
  </script>

  <script type="application/ld+json">
    <%= raw breadcrumb_structured_data([
      { name: "Home", url: root_url },
      { name: @product.category.slug == "branded-products" ? "Custom Branded Packaging" : @product.category.name,
        url: @product.category.slug == "branded-products" ? branded_products_url : category_browse_url(@product.category) },
      { name: @product.generated_title, url: product_url(@product) }
    ]) %>
  </script>

  <%# GA4 E-commerce: view_item event %>
  <script>
    <%= ecommerce_view_item_event(@product) %>
  </script>

  <%# DataFast: view_item goal %>
  <script>
    <%= datafast_view_item_goal(@product) %>
  </script>
<% end %>

<% content_for :breadcrumbs do %>
  <%= render "shared/breadcrumbs", product: @product %>
<% end %>

<div class="drawer drawer-end">
  <input id="cart-drawer" type="checkbox" class="drawer-toggle" aria-label="Toggle shopping cart" />

  <div class="drawer-content">
    <div class="container mx-auto min-h-screen py-4 pb-8">

      <%# items-start is what makes the pin below possible: flex children stretch
          to the tallest sibling by default, and a full-height column has nothing
          to scroll within. %>
      <div class="flex flex-col lg:flex-row lg:items-start gap-8 lg:gap-12">

        <%# Image Section. Pinned on wide screens, where the media column is much
            shorter than the buy column and would otherwise scroll away, leaving
            the buyer deciding on lids and quantity beside empty space. Phones
            stack the columns, so there the image scrolls off as normal rather
            than eating the viewport the buy box needs. %>
        <div data-test="product-media"
             class="lg:w-1/2 flex-shrink-0 lg:sticky lg:top-4"
             data-controller="product-card-hover"
             data-action="mouseenter->product-card-hover#mouseenter mouseleave->product-card-hover#mouseleave">
          <div class="bg-white rounded-lg overflow-hidden relative">
            <% if @product.vegware? %>
              <%= render "shared/vegware_badge" %>
            <% end %>
            <div class="product-image-container">
              <% if @product.product_photo.attached? %>
                <%= image_tag @product.product_photo.variant(resize_and_pad: [800, 800, { background: [255, 255, 255] }], format: :webp, saver: { quality: 80 }),
                              alt: @product.generated_title,
                              class: "product-image w-full h-auto object-contain",
                              fetchpriority: "high",
                              width: 800,
                              height: 800,
                              data: { product_card_hover_target: "productPhoto" } %>
              <% elsif @product.lifestyle_photo.attached? %>
                <%= image_tag @product.lifestyle_photo.variant(resize_and_pad: [800, 800, { background: [255, 255, 255] }], format: :webp, saver: { quality: 80 }),
                              alt: @product.generated_title,
                              class: "product-image w-full h-auto object-contain",
                              fetchpriority: "high",
                              width: 800,
                              height: 800 %>
              <% end %>

              <% if @product.product_photo.attached? && @product.lifestyle_photo.attached? %>
                <%= image_tag @product.lifestyle_photo.variant(resize_and_pad: [800, 800, { background: [255, 255, 255] }], format: :webp, saver: { quality: 80 }),
                              alt: "#{@product.generated_title} lifestyle",
                              class: "product-image product-image-overlay w-full h-auto object-contain",
                              loading: "lazy",
                              width: 800,
                              height: 800,
                              data: { product_card_hover_target: "lifestylePhoto" } %>
              <% end %>
            </div>
          </div>
        </div>

        <%# Content Section %>
        <% has_tiers = @product.pricing_tiers.present? %>
        <%# The buy column owns the shared state: quantity or tier drives the
            Total, the attach block feeds into it, and the free-delivery
            countdown watches the resulting figure. %>
        <div class="lg:w-1/2 text-center lg:text-left"
             data-free-delivery-threshold-value="<%= free_shipping_threshold_amount %>"
             data-free-delivery-cart-subtotal-value="<%= (Current.cart&.subtotal_amount || 0).to_f %>"
             <%# What the page opens on, so the hint is right before the buyer
                 touches anything. Tiered products open on the largest tier,
                 which is the one the tier controller pre-selects. %>
             data-free-delivery-opening-total-value="<%= (has_tiers ? @product.pricing_tiers.last["price"] : @product.price).to_f %>"
             <% if has_tiers %>
               data-controller="pricing-tier sticky-atc free-delivery"
               data-action="attach-companions:changed->pricing-tier#companionsChanged
                            buy-box:totalChanged->free-delivery#totalChanged"
               data-pricing-tier-tiers-value="<%= @product.pricing_tiers.to_json %>"
               data-pricing-tier-default-price-value="<%= @product.price.to_f %>"
               data-pricing-tier-default-pac-size-value="<%= @product.pac_size || 1 %>"
             <% else %>
               data-controller="quantity-selector sticky-atc free-delivery"
               data-action="attach-companions:changed->quantity-selector#companionsChanged
                            buy-box:totalChanged->free-delivery#totalChanged"
               data-quantity-selector-price-value="<%= @product.price.to_f %>"
               data-quantity-selector-pac-size-value="<%= @product.pac_size || 1 %>"
             <% end %>>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl">
            <%= @product.generated_title %>
          </h1>

          <%# Price Display: pack price paired with the per-unit rate buyers
              compare across suppliers. Tiered products seed from the tier the
              tier controller pre-selects, then it keeps both in step. %>
          <div class="flex items-baseline justify-center lg:justify-start gap-3 flex-wrap mt-3">
            <% if has_tiers %>
              <% seed_tier = @product.pricing_tiers.last %>
              <p class="text-xl" data-pricing-tier-target="priceDisplay">
                From <%= number_to_currency(@product.pricing_tiers.first["price"].to_f) %>
              </p>
              <% unit_price = pdp_unit_price(@product, tier: seed_tier) %>
              <% if unit_price %>
                <p class="text-base text-base-content/60"
                   data-test="pdp-unit-price"
                   data-pricing-tier-target="unitPriceDisplay">
                  <%= unit_price %>
                </p>
              <% end %>
            <% else %>
              <p class="text-xl">
                <% if @product.pac_size && @product.pac_size > 1 %>
                  <%= number_to_currency(@product.price) %> / pack of <%= number_with_delimiter(@product.pac_size) %>
                <% else %>
                  <%= number_to_currency(@product.price) %>
                <% end %>
              </p>
              <% unit_price = pdp_unit_price(@product) %>
              <% if unit_price %>
                <p class="text-base text-base-content/60" data-test="pdp-unit-price">
                  <%= unit_price %>
                </p>
              <% end %>
            <% end %>
          </div>

          <%# SKU %>
          <div class="mt-2">
            <span class="text-sm text-base-content/50 font-mono">
              SKU: <%= @product.sku %>
            </span>
          </div>

          <%# Short Description %>
          <% if @product.description_standard_with_fallback.present? %>
            <p class="text-lg text-gray-700 mt-4">
              <%= @product.description_standard_with_fallback %>
            </p>
          <% end %>

          <% if has_tiers %>
            <%# === Pricing Tier Selector === %>
            <div class="mt-6">
              <label class="block text-lg font-medium mb-3">Select option</label>
              <div class="flex flex-col gap-3" role="listbox" aria-label="Select pack size">
                <% pricing_tier_breakdown(@product.pricing_tiers).each do |tier| %>
                  <div class="border border-gray-200 bg-white rounded-xl px-3 sm:px-4 py-3 cursor-pointer hover:border-primary transition flex items-center gap-2 sm:gap-3"
                       data-pricing-tier-target="tierCard"
                       data-tier-price="<%= tier[:price] %>"
                       data-tier-quantity="<%= tier[:quantity] %>"
                       data-action="click->pricing-tier#selectTier keydown->pricing-tier#handleCardKeydown"
                       role="option"
                       aria-selected="false"
                       tabindex="0">
                    <%# Column 1: Pack / case size %>
                    <div class="font-medium whitespace-nowrap flex-1 min-w-0">
                      <%= tier[:quantity] >= 100 ? "Case" : "Pack" %> of <%= number_with_delimiter(tier[:quantity]) %>
                    </div>

                    <%# Column 2: Unit price %>
                    <div class="text-gray-400 whitespace-nowrap shrink-0">
                      <%= number_to_currency(tier[:price_per_unit], precision: 3) %>/unit
                    </div>

                    <%# Column 3: Savings badge %>
                    <div class="text-success text-sm font-medium whitespace-nowrap shrink-0 <%= "invisible" if tier[:savings_percent].blank? %>">
                      <% if tier[:savings_percent].present? %>save <%= tier[:savings_percent] %>%<% end %>
                    </div>

                    <%# Column 4: Total price %>
                    <div class="font-medium text-right whitespace-nowrap shrink-0">
                      <%= number_to_currency(tier[:price]) %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>

            <%# Quantity (how many of selected tier) %>
            <div class="mt-6">
              <label for="quantity" class="block text-lg font-medium mb-2">Quantity</label>
              <div class="flex items-center justify-center lg:justify-start gap-4">
                <%= render "products/quantity_stepper", controller: "pricing-tier" %>
                <span class="text-base-content/60" data-pricing-tier-target="unitsDisplay"></span>
              </div>
            </div>
          <% else %>
            <%# === Standard Quantity Selector (no tiers) === %>
            <div class="mt-6">
              <label for="quantity" class="block text-lg font-medium mb-2">Quantity</label>
              <div class="flex items-center justify-center lg:justify-start gap-4">
                <%= render "products/quantity_stepper", controller: "quantity-selector" %>
                <% if @product.pac_size && @product.pac_size > 1 %>
                  <span class="text-base-content/60" data-quantity-selector-target="unitsDisplay">
                    (<%= number_with_delimiter(@product.pac_size) %> units)
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>

          <%# Add to Cart Form. It wraps the attach block, the delivery promise
              and the total so one submit buys the product plus everything
              ticked, and so the last number read before committing includes
              the whole selection. Nothing interrupts quantity -> attach ->
              total -> Add to Cart; the contact and sample routes wait below. %>
          <%= form_with url: cart_cart_items_path,
                        method: :post,
                        id: "add-to-cart-form",
                        data: { controller: "cart-drawer", action: "turbo:submit-end->cart-drawer#open", turbo: true } do |f| %>
            <%= hidden_field_tag "cart_item[sku]", @product.sku %>

            <% if @compatible_products.any? %>
              <%= render "products/attach_block",
                         companions: @compatible_products,
                         heading: "Add matching lids",
                         subheading: "Complete your order with lids that fit.",
                         fit_label: "Fits this #{@product.category.name.singularize.downcase}",
                         link_names: false,
                         visible_count: nil,
                         disclosure_noun: "matching lids",
                         highlighted_id: @default_lid_id %>
            <% elsif @compatible_containers.any? %>
              <%= render "products/attach_block",
                         companions: @compatible_containers,
                         heading: "Fits these containers",
                         subheading: "This lid is matched to the containers below. Add them together.",
                         fit_label: "This lid fits it",
                         link_names: true,
                         visible_count: ProductsController::ATTACH_ROWS_VISIBLE,
                         disclosure_noun: "compatible containers",
                         highlighted_id: nil %>
            <% end %>

            <%# Order Summary %>
            <div class="mt-6 space-y-2">
              <div class="flex items-center gap-2 justify-center lg:justify-start text-sm sm:text-base" data-controller="delivery-countdown" data-delivery-countdown-cutoff-at-value="<%= @delivery_estimate.cutoff_at.iso8601 %>">
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
                <%# The date is the mainland promise: we don't know the visitor's
                    address yet, and Northern Ireland, the Highlands and the
                    islands take longer. The cart's delivery calculator gives the
                    real date once a postcode is entered. %>
                <span>
                  Delivery to mainland UK <span class="text-gray-900"><%= @delivery_estimate.formatted %></span>.
                  Order within <span data-delivery-countdown-target="countdown" class="text-green-600 font-medium"></span>.
                </span>
              </div>

              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pt-4 border-t border-base-200">
                <p class="text-base sm:text-lg">
                  Total (excl. VAT)
                  <% if @compatible_products.any? || @compatible_containers.any? %>
                    <span class="block text-sm text-base-content/60">Includes anything ticked above</span>
                  <% end %>
                </p>
                <% if has_tiers %>
                  <p class="text-xl sm:text-2xl" data-pricing-tier-target="totalDisplay">
                    <%= number_to_currency(@product.pricing_tiers.first["price"].to_f) %>
                  </p>
                <% else %>
                  <p class="text-xl sm:text-2xl" data-quantity-selector-target="totalDisplay">
                    <%= number_to_currency(@product.price) %>
                  </p>
                <% end %>
              </div>
            </div>

            <div class="mt-4">
              <% if has_tiers %>
                <input type="hidden"
                       name="cart_item[quantity]"
                       data-pricing-tier-target="quantityInput"
                       value="1" />
                <input type="hidden"
                       name="cart_item[tier_price]"
                       data-pricing-tier-target="priceInput"
                       value="" />
                <input type="hidden"
                       name="cart_item[tier_pac_size]"
                       data-pricing-tier-target="pacSizeInput"
                       value="" />
                <button type="submit" class="btn btn-primary btn-lg w-full"
                        data-pricing-tier-target="addToCartButton"
                        data-sticky-atc-target="mainButton"
                        disabled>
                  Add to Cart
                </button>
              <% else %>
                <input type="hidden"
                       name="cart_item[quantity]"
                       data-quantity-selector-target="quantityInput"
                       value="1" />
                <button type="submit" class="btn btn-primary btn-lg w-full"
                        data-sticky-atc-target="mainButton">
                  Add to Cart
                </button>
              <% end %>
            </div>
          <% end %>

          <%# Free delivery counts down rather than posts a rule: a buyer told
              they are £12 short tops up, a buyer told only "over £100" has to
              work it out. The threshold and what the cart already holds come
              from the server; the client subtracts the on-page selection.
              Checkout stays the only authority on what is actually charged, and
              the promise stays mainland-qualified because this page does not
              know the destination. %>
          <div data-test="free-delivery-hint"
               class="mt-3 flex items-center justify-center gap-2 text-base text-base-content/80">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zm10 0a2 2 0 11-4 0 2 2 0 014 0zM3 4h2l2 11h11l2-7H7"/>
            </svg>
            <span data-free-delivery-target="message">Free delivery on mainland UK orders over <span data-test="free-delivery-amount" class="text-success"><%= free_shipping_threshold_display %></span></span>
          </div>

          <%= render "products/trust_strip" %>

          <%# Secondary routes, after the primary action rather than through it:
              a quote for what we don't stock, and a sample for buyers who want
              to see it first. %>
          <%= render "products/sample_cta", product: @product %>

          <div class="mt-4">
            <div class="bg-base-200 rounded-lg p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
              <div>
                <p class="font-sm">Can't find what you're looking for?</p>
                <p class="text-xs">Need a different size, quantity, or material ...</p>
              </div>
              <%= link_to "Get in touch", contact_path, class: "link link-hover underline font-medium whitespace-nowrap" %>
            </div>
          </div>

          <%# Sticky Add-to-Cart Bar (mobile only) %>
          <div data-sticky-atc-target="stickyBar"
               class="fixed bottom-0 inset-x-0 bg-base-100 border-t border-base-300 px-4 py-3 md:hidden z-40 translate-y-full transition-transform duration-300 ease-in-out">
            <div class="flex items-center gap-3 max-w-lg mx-auto">
              <div class="flex-1 min-w-0">
                <p class="font-medium text-sm truncate"><%= @product.generated_title %></p>
                <p class="text-sm text-base-content/70">
                  <% if has_tiers %>
                    From <%= number_to_currency(@product.pricing_tiers.first["price"].to_f) %>
                  <% elsif @product.pac_size && @product.pac_size > 1 %>
                    <%= number_to_currency(@product.price) %> / pack of <%= number_with_delimiter(@product.pac_size) %>
                  <% else %>
                    <%= number_to_currency(@product.price) %>
                  <% end %>
                </p>
              </div>
              <button type="submit" form="add-to-cart-form" class="btn btn-primary btn-sm flex-shrink-0">
                Add to Cart
              </button>
            </div>
          </div>

        </div>
      </div>

      <%# Product Details Section %>
      <% if @product.description_detailed_with_fallback.present? %>
        <div class="mt-12 space-y-8">
          <div class="prose max-w-none">
            <h2>Product Details</h2>
            <%= render_product_description(@product.description_detailed_with_fallback) %>
          </div>
        </div>
      <% end %>

      <%= render "products/specifications", product: @product %>

      <%= render "products/social_proof" %>

      <%# Shop More in Category Section %>
      <div class="mt-12 p-6 bg-base-200 rounded-lg">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h2 class="text-xl mb-1">Explore More <%= @category.name %></h2>
            <p class="text-base-content/70">Browse our full range of <%= @category.name.downcase %>.</p>
          </div>
          <%= link_to category_browse_path(@category), class: "btn btn-outline" do %>
            View All <%= @category.name %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          <% end %>
        </div>
      </div>

      <%# Related Products Section %>
      <% if @related_products.any? %>
        <div class="mt-12">
          <h2 class="text-2xl mb-6">Related Products</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <%= render partial: "products/card", collection: @related_products, as: :product %>
          </div>
        </div>
      <% end %>

    </div>
  </div>

  <%# Cart Drawer %>
  <%= render "shared/cart_drawer", z_index: "z-50" %>

</div>
