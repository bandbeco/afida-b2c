<% specification = ProductSpecification.new(product) %>
<% if specification.any? %>
  <%# Specs as a flowing grid of one-fact tiles rather than two headed columns.
      The fields are sparse (no single one covers the catalogue, and half the
      products know only one measurement), so fixed groups regularly left a
      heading holding a single row beside a full one. A grid fills in whatever
      order the facts exist, and each tile is scannable on its own. %>
  <section data-test="product-specifications" class="mt-12 border-t border-base-200 pt-8">
    <h2 class="text-2xl mb-6">Specifications</h2>

    <dl data-test="specifications-grid"
        class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      <% specification.rows.each do |row| %>
        <div data-test="specification-tile"
             class="bg-base-200 rounded-lg px-4 py-3">
          <dt class="text-xs uppercase tracking-wide text-base-content/60"><%= row[:label] %></dt>
          <dd class="text-lg mt-1 leading-snug">
            <%= row[:value] %><% if row[:unit] %> <span class="text-sm text-base-content/60"><%= row[:unit] %></span><% end %>
          </dd>
        </div>
      <% end %>
    </dl>

    <% if specification.certifications? %>
      <%# Certifications are named awards, not label/value facts, so they read
          as a row of badges rather than as tiles with "Yes" in them. %>
      <div data-test="specifications-certifications" class="mt-4 flex flex-wrap items-center gap-2">
        <span class="text-xs uppercase tracking-wide text-base-content/60">Certified</span>
        <% specification.certifications.each do |cert| %>
          <span data-test="certification-badge" class="badge badge-outline"><%= cert %></span>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>
